{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/agent-guardrails.mjs\" --codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tools/hooks/agent-guardrails.mjs\" --codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
